generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 다국어 지원
enum Locale {
  ko
  en
}

// 리그
model League {
  id   Int    @id @default(autoincrement())
  slug String @unique // url path (.../leagues/[league.slug]/[leagueDivision.slug])
  name String

  // 1:N
  divisions LeagueDivision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 리그 부문
model LeagueDivision {
  id Int @id @default(autoincrement())

  // N:1
  leagueId Int
  league   League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  locale    Locale
  slug      String // url path (.../leagues/[league.slug]/[leagueDivision.slug])
  name      String
  imageUrl  String?
  cmsPageId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([leagueId, slug, locale]) // 종목별 언어가 하나씩 존재함
  @@index([locale]) // 다국어 필터링을 위함
}

model Event {
  id        Int      @id @default(autoincrement())
  slug      String   @unique // url path (.../events/[slug])
  year      String
  dateStart DateTime
  dateEnd   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 1:N
  details EventDetail[]
}

model EventDetail {
  id Int @id @default(autoincrement())

  // N:1
  eventId Int
  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  locale         Locale
  title          String
  location       String? // 위치
  address        String? // 상세주소
  posterImageUrl String?
  cmsPageId      String?

  showInEvents Boolean @default(false) // (.../events)에 표시 여부
  showInMain   Boolean @default(false) // (.../home)에 표시 여부

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, locale]) // 대회별 언어가 하나씩 존재함
}

// 인증 교육기관
model LearningCenter {
  id        Int      @id @default(autoincrement())
  alias     String // 기관 별칭
  name      String // 기관 명칭
  address   String // 상세 주소
  latitude  Float? // 위도
  longitude Float? // 경도
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
